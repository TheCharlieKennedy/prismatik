{
  "name": "prismatik-utils",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/prismatik-utils.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/prismatik-utils.js"
    },
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "default": "./dist/orbit.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "default": "./dist/gif.js"
    },
    "./obj": {
      "types": "./dist/obj.d.ts",
      "default": "./dist/obj.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "prismatik-core": "*"
  },
  "dependencies": {
    "prismatik-core": "file:../prismatik-core"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
