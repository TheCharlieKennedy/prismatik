{
  "name": "prismatik-utils",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/prismatik-utils.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/prismatik-utils.js"
    },
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "default": "./dist/orbit.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "default": "./dist/gif.js"
    },
    "./obj": {
      "types": "./dist/obj.d.ts",
      "default": "./dist/obj.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "default": "./dist/overlay.js"
    },
    "./drag": {
      "types": "./dist/drag.d.ts",
      "default": "./dist/drag.js"
    },
    "./autoRotate": {
      "types": "./dist/autoRotate.d.ts",
      "default": "./dist/autoRotate.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "prismatik-core": "*"
  },
  "dependencies": {
    "prismatik-core": "file:../prismatik-core"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
